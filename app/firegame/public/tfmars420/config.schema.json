{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tfmars420 runtime config",
  "type": "object",
  "required": ["version", "skills"],
  "properties": {
    "version": {
      "const": 1
    },
    "skills": {
      "type": "object",
      "properties": {
        "timeWarp": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "panel": {
              "type": "object",
              "properties": {
                "queueMaxHeight": {
                  "type": ["number", "string", "null"]
                }
              },
              "additionalProperties": false
            },
            "fallbackRenderer": {
              "type": "object",
              "properties": {
                "preserveFormWhileActive": {
                  "type": "boolean"
                },
                "cardListMaxHeight": {
                  "type": ["number", "string", "null"]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
